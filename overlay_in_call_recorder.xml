<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlay_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/bg_floating_pill"
    android:paddingStart="12dp"
    android:paddingEnd="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:gravity="center_vertical"
    android:elevation="12dp">

    <!-- Manual Record / Stop Button -->
    <ImageButton
        android:id="@+id/btn_manual_record"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_circle_red"
        android:src="@drawable/ic_mic_start"
        android:contentDescription="Start or Stop Call Recording" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="12dp">

        <TextView
            android:id="@+id/tv_record_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap to Record"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/tv_record_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textSize="11sp"
            android:textColor="#B0BEC5" />
    </LinearLayout>

</LinearLayout>
